{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://jorisjonkers.dev/schemas/cluster-composition-lock/v1",
  "title": "ClusterCompositionLock",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "const": "deployment.jorisjonkers.dev/cluster-composition-lock/v1" },
    "kind": { "type": "string", "const": "ClusterCompositionLock" },
    "metadata": {
      "type": "object",
      "required": ["environment", "generatedAt"],
      "properties": {
        "environment": { "type": "string" },
        "generatedAt": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["schemaVersion", "composedRootDigest", "generatedFromCommit", "lockChain", "publicContext", "internalContext", "units", "aggregates", "dependencyGraph"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "composedRootDigest": { "type": "string", "pattern": "^sha256:" },
        "generatedFromCommit": { "type": "string" },
        "previousLockDigest": { "oneOf": [{ "type": "string", "pattern": "^sha256:" }, { "type": "null" }] },
        "lockChain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["digest", "commit", "timestamp"],
            "properties": {
              "digest": { "type": "string" },
              "commit": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        },
        "publicContext": {
          "type": "object",
          "required": ["ref", "digest", "inventorySourceSha"],
          "properties": {
            "ref": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:" },
            "inventorySourceSha": { "type": "string" }
          }
        },
        "internalContext": {
          "type": "object",
          "required": ["ref", "digest", "inventorySourceSha"],
          "properties": {
            "ref": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256:" },
            "inventorySourceSha": { "type": "string" }
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["artifactRef", "artifactDigest", "artifactContractRenderHash", "namespace", "layer", "schemaVersion", "healthClass", "prune", "imageDigests"],
            "properties": {
              "artifactRef": { "type": "string" },
              "artifactDigest": { "type": "string", "pattern": "^sha256:" },
              "artifactContractRenderHash": { "type": "string", "pattern": "^sha256:" },
              "namespace": { "type": "string" },
              "layer": { "type": "string" },
              "schemaVersion": { "type": "string" },
              "healthClass": { "type": "string", "enum": ["stateless", "stateful", "control-plane"] },
              "prune": { "type": "boolean" },
              "imageDigests": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "aggregates": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["path", "digest"],
            "properties": {
              "path": { "type": "string" },
              "digest": { "type": "string", "pattern": "^sha256:" }
            }
          }
        },
        "dependencyGraph": {
          "type": "object",
          "required": ["order"],
          "properties": {
            "order": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}

# services/auth-api/platform/env/auth-api/base.env
#
# Note what is NOT here. auth-api holds three secrets and none of them appear
# in this file, because all three use delivery: self -- the application fetches
# them through spring-cloud-vault at runtime. A grant only requires a matching
# placeholder when delivery is env.

SPRING_PROFILES_ACTIVE=prod
SESSION_COOKIE_SECURE=true

DB_HOST=${dependency:platform-postgres.host}
DB_PORT=${dependency:platform-postgres.port}
VALKEY_HOST=${dependency:platform-valkey.host}
VALKEY_PORT=${dependency:platform-valkey.port}
SPRING_RABBITMQ_HOST=${dependency:platform-rabbitmq.host}
SPRING_RABBITMQ_PORT=${dependency:platform-rabbitmq.port}
MAIL_HOST=${dependency:stalwart.host}
MAIL_PORT=${dependency:stalwart.port}

# Hand-written today, derived under this model, and a build error to author:
#
#   AUTH_ISSUER, AUTH_LOGIN_URL, CONFIRMATION_URL
#     -> from this Workload's own assigned exposure
#
#   AUTH_CORS_ALLOWED_ORIGINS
#     -> from INBOUND edges. Nine hostnames are maintained by hand today:
#        jorisjonkers.dev, auth, agents, vault, n8n, grafana, dashboard,
#        rabbitmq, status. See chapter 16 -- the exact predicate is open.
#
#   MAIL_USERNAME (auth@jorisjonkers.dev)
#     -> from the cluster public domain plus this Service's id
#
#   VAULT_ADDR, VAULT_ENABLED, VAULT_AUTHENTICATION,
#   VAULT_KUBERNETES_ROLE, VAULT_DB_ENABLED, SPRING_CONFIG_IMPORT
#     -> from delivery: self in service.yml. It renders its own wiring.
#
#   AUTH_TRANSIT_ENABLED, AUTH_TRANSIT_KEY_NAME
#     -> from the transit grant in service.yml
#
#   OTEL_* (10), PYROSCOPE_* (6)  -> from runtime: jvm
#   SERVER_PORT, DEPLOYMENT_ENVIRONMENT -> from exposure, Cluster Target

# services/knowledge/platform/env/knowledge-api/base.env
#
# One file per Workload (docs/adr/0011-configuration-env-files-per-workload.md).
# Literals are literal. Derived values are named placeholders. A literal for a
# derived key is a build error, and so is any OTEL_* or PYROSCOPE_* key --
# those come from runtime: jvm.

# --- app knobs
SPRING_PROFILES_ACTIVE=prod
KB_RECALL_DEFAULT_MODE=hybrid
KNOWLEDGE_MODE=lite

# --- coordinates, from dependsOn
DB_HOST=${dependency:platform-postgres.host}
DB_PORT=${dependency:platform-postgres.port}
DB_NAME=${dependency:platform-postgres.database}
RABBITMQ_HOST=${dependency:platform-rabbitmq.host}
RABBITMQ_PORT=${dependency:platform-rabbitmq.port}

# --- secrets, each BYTE-MATCHING a granted path
#     (docs/adr/0027-secret-reference-join-key.md). The string between
#     ${secret: and # is the same string the grant writes as `path:` -- mount
#     and KV `data/` segment included. There is no strip rule to learn and no
#     mount table for the composer to carry, so E_UNAUTHORISED_SECRET_REFERENCE
#     and the dead-grant check are string comparisons over the composed union.
#     The `#<key>` half selects which value fills the variable and confers
#     nothing: the grant unit is the path.
#
#     postgres and rabbitmq are Service-level grants, mcp-bearer is this
#     Workload's own. These render as envFrom secretRef entries, never as
#     literal values.
DB_USER=${secret:secret/data/platform/postgres/kb#user}
DB_PASSWORD=${secret:secret/data/platform/postgres/kb#password}
RABBITMQ_USER=${secret:secret/data/platform/rabbitmq#rabbitmq.user}
RABBITMQ_PASSWORD=${secret:secret/data/platform/rabbitmq#rabbitmq.password}
KNOWLEDGE_MCP_TOKENS_WORKSTATION=${secret:secret/data/knowledge-system/mcp-bearer#workstation}

# The placeholder names the source; the key names the variable. That is what
# lets knowledge write DB_USER where another consumer of the same Postgres
# writes DB_POSTGRESDB_USER. Renaming a path edits the grant and every
# placeholder naming it in lockstep -- which is also what made the
# platform/postgres split a mechanical change: one grep finds every reader.

# NOT here, and a build error if they were:
#   SERVER_PORT             -> from the exposure port
#   DEPLOYMENT_ENVIRONMENT  -> from the Cluster Target
#   OTEL_* (10 keys)        -> from runtime: jvm
#   PYROSCOPE_* (6 keys)    -> from runtime: jvm
#
# production.env sits alongside this file and is currently empty: nothing
# differs for the production cluster.

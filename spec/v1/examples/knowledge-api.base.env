# services/knowledge/platform/env/knowledge-api/base.env
#
# Literals are literal. Derived values are named placeholders. A literal for a
# derived key is a build error, and so is any OTEL_* or PYROSCOPE_* key --
# those come from runtime: jvm.

# --- app knobs
SPRING_PROFILES_ACTIVE=prod
KB_RECALL_DEFAULT_MODE=hybrid
KNOWLEDGE_MODE=lite

# --- coordinates, from dependsOn
DB_HOST=${dependency:platform-postgres.host}
DB_PORT=${dependency:platform-postgres.port}
DB_NAME=${dependency:platform-postgres.database}
RABBITMQ_HOST=${dependency:platform-rabbitmq.host}
RABBITMQ_PORT=${dependency:platform-rabbitmq.port}

# --- secrets, each matching a grant in service.yml (postgres and rabbitmq
#     at Service level, mcp-bearer on this Workload).
#     These render as envFrom secretRef entries, not literal values.
DB_USER=${secret:platform/postgres#kb.user}
DB_PASSWORD=${secret:platform/postgres#kb.password}
RABBITMQ_USER=${secret:platform/rabbitmq#rabbitmq.user}
RABBITMQ_PASSWORD=${secret:platform/rabbitmq#rabbitmq.password}
KNOWLEDGE_MCP_TOKENS_WORKSTATION=${secret:knowledge-system/mcp-bearer#workstation}

# NOT here, and a build error if they were:
#   SERVER_PORT             -> from the exposure port
#   DEPLOYMENT_ENVIRONMENT  -> from the Cluster Target
#   OTEL_* (10 keys)        -> from runtime: jvm
#   PYROSCOPE_* (6 keys)    -> from runtime: jvm
#
# production.env sits alongside this file and is currently empty: nothing
# differs for the production cluster.

# collections/data/platform-postgres/env/postgres/base.env
#
# A third-party image with runtime: none receives no profile values at all,
# so this file is short. The single secret placeholder is consumed by the
# postgres-exporter sidecar.

POSTGRES_DB=postgres
POSTGRES_USER=postgres

# The exporter's connection string. Matches the workload-level grant in
# service.yml; without
# that grant this line is an unauthorised reference, and without this line the
# grant is a dead grant.
DATA_SOURCE_NAME=${secret:platform/postgres#exporter.datasource}

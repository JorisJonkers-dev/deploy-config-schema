# services/knowledge/platform/env/knowledge-ingest-worker/base.env
#
# The second Workload of the same Service. Note what it shares and what it does
# not: the Postgres and RabbitMQ credentials come from Service-level grants, so
# they are referenced here as well as in knowledge-api's file. The deploy key
# is a Workload-level grant with delivery: file, so it has no placeholder here
# at all -- it lands on disk at 0400.

# --- app knobs, none of them shared with the api
INGEST_QUEUE=knowledge.ingest
INGEST_PREFETCH=4
LOG_LEVEL=INFO

# --- coordinates, from this Workload's own dependsOn
RABBITMQ_HOST=${dependency:platform-rabbitmq.host}
RABBITMQ_PORT=${dependency:platform-rabbitmq.port}
DB_HOST=${dependency:platform-postgres.host}
DB_PORT=${dependency:platform-postgres.port}
DB_NAME=${dependency:platform-postgres.database}

# --- secrets, both from Service-level grants
RABBITMQ_USER=${secret:platform/rabbitmq#rabbitmq.user}
RABBITMQ_PASSWORD=${secret:platform/rabbitmq#rabbitmq.password}
DB_USER=${secret:platform/postgres#kb.user}
DB_PASSWORD=${secret:platform/postgres#kb.password}

# NOT here: the vault-deploy-key. It is delivery: file, mounted at
# /home/worker/.ssh/id_ed25519 with mode 0400, and an SSH key cannot be an
# environment variable. A file-delivered grant needs no placeholder, and the
# dead-grant check knows not to require one.
#
#   OTEL_* (5 keys) + OTEL_PYTHON_LOG_CORRELATION -> from runtime: python
#   DEPLOYMENT_ENVIRONMENT -> from the Cluster Target
